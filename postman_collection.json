{
  "info": {
    "name": "Реестр заявок API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/register"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"student1\",\n  \"password\": \"123456\",\n  \"department\": \"Комитет по образованию\"\n}"
        }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/login"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"student1\",\n  \"password\": \"123456\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "pm.environment.set('token', data.access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Me",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/me"
        }
      }
    },
    {
      "name": "Get tickets",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/tickets"
        }
      }
    },
    {
      "name": "Get tickets by status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/tickets?status=новая"
        }
      }
    },
    {
      "name": "Get tickets by priority",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/tickets?priority=высокий"
        }
      }
    },
    {
      "name": "Get ticket",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/tickets/1"
        }
      }
    },
    {
      "name": "Create ticket",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/tickets"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"applicant\": \"Это поле будет заменено сервером\",\n  \"type\": \"Проблемы с сетью\",\n  \"description\": \"Не работает интернет\",\n  \"priority\": \"высокий\"\n}"
        }
      }
    },
    {
      "name": "Update ticket",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/tickets/1"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"applicant\": \"Комитет по образованию\",\n  \"type\": \"Проблемы с сетью\",\n  \"description\": \"Интернет не работает на втором этаже\",\n  \"priority\": \"средний\",\n  \"status\": \"в работе\"\n}"
        }
      }
    },
    {
      "name": "Delete ticket",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/tickets/1"
        }
      }
    }
  ]
}